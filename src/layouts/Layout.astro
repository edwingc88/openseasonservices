---
import '../styles/global.css';
---

<!doctype html>
<html lang="en"  class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>M&M Open Season Services LLC | Pressure Washing & Hydrojet in Annapolis, MD</title>
       <meta name="description" content="Professional pressure washing, hydrojet and soft wash services in Annapolis, MD. We clean homes, roofs, garages, service stations and commercial properties.">

		<!-- URL Canonical -->
  		<link rel="canonical" href="https://openseasonservices.us/">

		<!-- Open Graph para Redes Sociales  -->
		<meta property="og:type" content="website">
		<meta property="og:title" content="Open Season Services LLC | Home improvements, pressure washing and deck painting in Annapolis, MD">
		<meta property="og:description" content="Professional pressure washing, soft wash, and deck painting services in Annapolis, MD. Expert home improvements, hydrojet cleaning for roofs, siding, and commercial properties. Call today!">
		<meta property="og:image" content="https://openseasonservices.us/og-cover.jpeg">
		<meta property="og:url" content="https://openseasonservices.us/">
		<meta property="og:site_name" content="Open Season Services LLC">


		<!-- Google Fonts: Inter -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

		<!-- Font Awesome Icons -->
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
	</head>
	<body class="font-sans text-slate-800 bg-slate-50 antialiased selection:bg-brandGreen-500 selection:text-white">
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
