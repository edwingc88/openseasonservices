        <script>
        // Interactive Mobile Menu Toggle
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        const menuIcon = document.getElementById('menuIcon');

        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
            if (mobileMenu.classList.contains('hidden')) {
                menuIcon.className = 'fa-solid fa-bars text-2xl';
            } else {
                menuIcon.className = 'fa-solid fa-xmark text-2xl';
            }
        });

        // Close mobile menu when clicking any link
        document.querySelectorAll('.mobile-link').forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
                menuIcon.className = 'fa-solid fa-bars text-2xl';
            });
        });

        // BEFORE & AFTER SLIDER INTERACTIVE LOGIC
        const baContainer = document.getElementById('baSliderContainer');
        const baOverlay = document.getElementById('baOverlay');
        const baHandle = document.getElementById('baHandle');
        let isDragging = false;

        function updateSliderPosition(xPos) {
            const rect = baContainer.getBoundingClientRect();
            let x = xPos - rect.left;
            if (x < 0) x = 0;
            if (x > rect.width) x = rect.width;
            const percentage = (x / rect.width) * 100;
            baOverlay.style.width = percentage + '%';
            baHandle.style.left = percentage + '%';
        }

        baHandle.addEventListener('mousedown', () => { isDragging = true; });
        window.addEventListener('mouseup', () => { isDragging = false; });
        window.addEventListener('mousemove', (e) => {
            if (!isDragging) return;
            updateSliderPosition(e.clientX);
        });

        // Touch support for mobile devices
        baHandle.addEventListener('touchstart', () => { isDragging = true; });
        window.addEventListener('touchend', () => { isDragging = false; });
        window.addEventListener('touchmove', (e) => {
            if (!isDragging) return;
            if (e.touches.length > 0) {
                updateSliderPosition(e.touches[0].clientX);
            }
        });

        // Preset Images for Before/After Selector
        const baPresets = {
                        deckPainting: {
                before: "/antes-despues/antes-1.jpg",
                after: "/antes-despues/despues-1.jpg"
            },

            remodeling: {
                before: "/antes-despues/antes-2.jpeg",
                after: "/antes-despues/despues-2.jpeg"
            },
            pressureWashing: {
                before: "/antes-despues/antes-3.jpg",
                after: "/antes-despues/despues-3.jpg"
            },
            deckRestoration: {
                before: "/antes-despues/antes-5.jpg",
                after: "/antes-despues/despues-5.jpg"
            },
                        homeImprovement: {
                before: "/antes-despues/antes-6.jpeg",
                after: "/antes-despues/despues-6.jpeg"
            }
        };

        function changeBABag(type, selectedButton) {
            const beforeImg = document.getElementById('baBeforeImg');
            const afterImg = document.getElementById('baAfterImg');

            if (baPresets[type]) {
                beforeImg.src = baPresets[type].before;
                afterImg.src = baPresets[type].after;
            }

            // Update active button state
            document.querySelectorAll('.ba-btn').forEach(btn => {
                btn.className = 'ba-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200';
            });
            selectedButton.className = 'ba-btn active px-4 py-2 rounded-xl text-xs font-bold bg-brandBlue-700 text-white shadow';
        }

        document.querySelectorAll('.ba-btn').forEach(button => {
            button.addEventListener('click', () => {
                changeBABag(button.dataset.baType, button);
            });
        });

        // VIDEO PLAYER CONTROL
        function togglePlayVideo() {
            const video = document.getElementById('demoVideo');
            const playIcon = document.getElementById('playIcon');
            const playBtn = document.getElementById('playVideoBtn');

            if (video.paused) {
                video.play();
                playIcon.className = 'fa-solid fa-pause';
                playBtn.classList.add('opacity-30', 'hover:opacity-100');
            } else {
                video.pause();
                playIcon.className = 'fa-solid fa-play ml-1';
                playBtn.classList.remove('opacity-30');
            }
        }

        // FORM SUBMISSION HANDLERS
        function handleFormSubmit(event) {
            event.preventDefault();
            alert("¡Gracias por tu solicitud! Nos pondremos en contacto contigo en breve para darte la cotización exacta.");
            event.target.reset();
        }

        function handleMainFormSubmit(event) {
            event.preventDefault();
            const feedback = document.getElementById('formFeedback');
            feedback.classList.remove('hidden');
            setTimeout(() => {
                feedback.classList.add('hidden');
            }, 6000);
            event.target.reset();
        }
    </script>