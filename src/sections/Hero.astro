        function changeBABag(type) {
            const beforeImg = document.getElementById('baBeforeImg');
            const afterImg = document.getElementById('baAfterImg');

            if (baPresets[type]) {
                beforeImg.src = baPresets[type].before;
                afterImg.src = baPresets[type].after;
            }

            // Update active button state
            document.querySelectorAll('.ba-btn').forEach(btn => {
                btn.className = 'ba-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200';
            });
            event.currentTarget.className = 'ba-btn active px-4 py-2 rounded-xl text-xs font-bold bg-brandBlue-700 text-white shadow';
        }

        // VIDEO PLAYER CONTROL
        function togglePlayVideo() {
            const video = document.getElementById('demoVideo');
            const playIcon = document.getElementById('playIcon');
            const playBtn = document.getElementById('playVideoBtn');

            if (video.paused) {
                video.play();
                playIcon.className = 'fa-solid fa-pause';
                playBtn.classList.add('opacity-30', 'hover:opacity-100');
            } else {
                video.pause();
                playIcon.className = 'fa-solid fa-play ml-1';
                playBtn.classList.remove('opacity-30');
            }
        }

        // FORM SUBMISSION HANDLERS
        function handleFormSubmit(event) {
            event.preventDefault();
            alert("¡Gracias por tu solicitud! Nos pondremos en contacto contigo en breve para darte la cotización exacta.");
            event.target.reset();
        }

        function handleMainFormSubmit(event) {
            event.preventDefault();
            const feedback = document.getElementById('formFeedback');
            feedback.classList.remove('hidden');
            setTimeout(() => {
                feedback.classList.add('hidden');
            }, 6000);
            event.target.reset();
        }
    </script>